# Jenkins LTS con JDK 21 + Maven + Semgrep (SAST) para pipeline DevSecOps
FROM jenkins/jenkins:lts-jdk21

USER root

# Maven 3.9.9 (los builds del proyecto usan ./mvnw, pero se instala para tooling global)
ARG MAVEN_VERSION=3.9.9
RUN curl -fsSL https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz \
        | tar -xz -C /opt \
    && ln -s /opt/apache-maven-${MAVEN_VERSION}/bin/mvn /usr/local/bin/mvn

# Python3 + pip y Semgrep (SAST) para la etapa de análisis estático
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-venv \
    && pip3 install --no-cache-dir --break-system-packages semgrep \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Plugins esenciales de Jenkins para el pipeline
RUN jenkins-plugin-cli --plugins \
        workflow-aggregator \
        git \
        configuration-as-code \
        job-dsl \
        junit \
        jacoco \
        dependency-check-jenkins-plugin \
        sonar

USER jenkins
