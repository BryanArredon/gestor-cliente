# ============================================================
# Plantilla de variables de entorno - Ejercicio5MyAPIGestor
# Copia este archivo como .env y completa tus valores reales:
#   cp .env.example .env
# El archivo .env NUNCA se sube a Git.
# ============================================================

# Base de datos MariaDB
DB_URL=jdbc:mariadb://localhost:3306/dbgestor
DB_USERNAME=root
DB_PASSWORD=tu_password_aqui
DB_DRIVER=org.mariadb.jdbc.Driver

# Servidor
SERVER_PORT=8082

# El token de SonarQube NO va aqui: se pega en la interfaz de Jenkins
# (Manage Jenkins > Credentials > Global > Add Credentials > Secret text,
#  ID: sonarqube-token).
