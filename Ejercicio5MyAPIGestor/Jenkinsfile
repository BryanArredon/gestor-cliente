pipeline {
    agent any

    environment {
        JAVA_HOME = '/opt/java/openjdk'
        MAVEN_HOME = '/opt/apache-maven-3.9.9'
        PATH = "${JAVA_HOME}/bin:${MAVEN_HOME}/bin:${env.PATH}"
    }

    stages {
        stage('Preparation') {
        stage('Preparation & Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/BryanArredon/gestor-cliente'
            }
        }

        stage('Ver Directorio') {
        stage('Environment Diagnostic') {
            steps {
                sh 'ls -la'
                sh 'java -version'
                sh 'mvn -version'
            }
        }

        stage('Build & Test') {
        stage('Build, Test & JaCoCo Coverage') {
            steps {
                dir('Ejercicio5MyAPIGestor') {
                    sh 'mvn clean package -Dsurefire.useFile=false'
                    sh 'mvn clean test jacoco:report -Dsurefire.useFile=false'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'Ejercicio5MyAPIGestor/target/surefire-reports/*.xml'
                    jacoco execFile: 'Ejercicio5MyAPIGestor/target/jacoco.exec',
                           classPattern: 'Ejercicio5MyAPIGestor/target/classes',
                           sourcePattern: 'Ejercicio5MyAPIGestor/src/main/java',
                           exclusionPattern: '**/target/**'
                }
            }
        }

        stage('SonarQube Analysis') {
        stage('OWASP Dependency-Check (SCA)') {
            steps {
                // 'sonarServer' es el servidor SonarQube de
                // Manage Jenkins > System > SonarQube servers
                dir('Ejercicio5MyAPIGestor') {
                    // Exclusión de target en escaneo de vulnerabilidades
                    sh 'mvn dependency-check:check'
                }
            }
        }

        stage('SonarQube Quality Analysis') {
            steps {
                withSonarQubeEnv('sonarServer') {
                    // El token se toma de la credencial "Secret text"
                    // 'sonarqube-token' (Credentials > Global). Nunca del .env.
                    withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                        dir('Ejercicio5MyAPIGestor') {
                            sh '''
                                mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.5.0.6356:sonar \
                                -Dsonar.projectKey=Ejercicio5Cliente \
                                -Dsonar.projectName="Ejercicio5Cliente" \
                                -Dsonar.projectKey=Ejercicio5MyAPIGestor \
                                -Dsonar.projectName="Ejercicio5MyAPIGestor" \
                                -Dsonar.host.url=http://sonarqube:9000 \
                                -Dsonar.login="${SONAR_TOKEN}" \
                                -Dsonar.exclusions="**/target/**,**/*.md" \
                                -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                            '''
                        }
                    }
                }
            }
        }

        stage('Package Artifact') {
            steps {
                dir('Ejercicio5MyAPIGestor') {
                    sh 'mvn package -DskipTests'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'Ejercicio5MyAPIGestor/target/*.jar', fingerprint: true, allowEmptyArchive: true
                }
            }
        }
    }

    post {
        failure {
            echo '[ERROR] Pipeline Backend falló. Revisar la consola y los reportes de calidad.'
        }
        success {
            echo '[SUCCESS] Pipeline Backend completado exitosamente con análisis de calidad y cobertura.'
        }
    }
}
