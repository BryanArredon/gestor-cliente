# ============================================================
# Plantilla de variables de entorno - Ejercicio5Cliente
# Copia este archivo como .env y completa tus valores reales:
#   cp .env.example .env
# El archivo .env NUNCA se sube a Git.
# ============================================================

# Puerto del frontend
SERVER_PORT=8083

# URL base del backend Ejercicio5MyAPIGestor
API_BASE_URL=http://localhost:8082

# SonarQube (token personal generado en SonarQube > My Account > Security)
SONAR_TOKEN=tu_token_aqui
