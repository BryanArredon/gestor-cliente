pipeline {
    agent any

    tools {
        maven 'Maven-3.9.9'
        jdk   'JDK-21'
    }

    environment {
        JAVA_HOME = "${env.JDK_HOME ?: '/opt/java/openjdk'}"
        MAVEN_OPTS = '-Dmaven.artifact.threads=10'
        JAVA_HOME = '/opt/java/openjdk'
        MAVEN_HOME = '/opt/apache-maven-3.9.9'
        PATH = "${JAVA_HOME}/bin:${MAVEN_HOME}/bin:${env.PATH}"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 40, unit: 'MINUTES')
    }

    stages {
        stage('Preparation & Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/BryanArredon/gestor-cliente'
            }
        }

        stage('Checkout') {
        stage('Environment Diagnostic') {
            steps {
                checkout scm
                sh 'java -version'
                sh 'mvn -version'
            }
        }

        stage('Build + Unit Tests + JaCoCo') {
        stage('Build, Test & JaCoCo Coverage') {
            steps {
                sh './mvnw clean test jacoco:report'
                dir('Ejercicio5Cliente') {
                    sh 'mvn clean test jacoco:report -Dsurefire.useFile=false'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
                    jacoco exclusions: '**/target/**'
                    junit allowEmptyResults: true, testResults: 'Ejercicio5Cliente/target/surefire-reports/*.xml'
                    jacoco execFile: 'Ejercicio5Cliente/target/jacoco.exec',
                           classPattern: 'Ejercicio5Cliente/target/classes',
                           sourcePattern: 'Ejercicio5Cliente/src/main/java',
                           exclusionPattern: '**/target/**'
                }
            }
        }

        stage('OWASP Dependency-Check (SCA)') {
            steps {
                sh './mvnw dependency-check:check -Ddependency-check.data.directory=$WORKSPACE/.dependency-check-data'
                dir('Ejercicio5Cliente') {
                    sh 'mvn dependency-check:check'
                }
            }
        }

        stage('SonarQube Analysis') {
        stage('SonarQube Quality Analysis') {
            steps {
                sh './mvnw sonar:sonar -Dsonar.host.url=http://sonarqube:9000 -Dsonar.login=$SONAR_TOKEN'
                withSonarQubeEnv('sonarServer') {
                    withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                        dir('Ejercicio5Cliente') {
                            sh '''
                                mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.5.0.6356:sonar \
                                -Dsonar.projectKey=Ejercicio5Cliente \
                                -Dsonar.projectName="Ejercicio5Cliente" \
                                -Dsonar.host.url=http://sonarqube:9000 \
                                -Dsonar.login="${SONAR_TOKEN}" \
                                -Dsonar.exclusions="**/target/**,**/*.md,**/*.html,**/*.css,**/*.js" \
                                -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                            '''
                        }
                    }
                }
            }
        }

        stage('Semgrep SAST') {
            steps {
                sh 'semgrep scan --config="p/java" --config="p/spring" --json -o semgrep-report.json .'
                dir('Ejercicio5Cliente') {
                    sh 'semgrep scan --config="p/java" --config="p/spring" --exclude="target" --json -o semgrep-report.json . || true'
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'semgrep-report.json', allowEmptyArchive: true
                    archiveArtifacts artifacts: 'Ejercicio5Cliente/semgrep-report.json', allowEmptyArchive: true
                }
            }
        }

        stage('Package (Deploy ready)') {
        stage('Package Artifact') {
            steps {
                sh './mvnw package -DskipTests'
                dir('Ejercicio5Cliente') {
                    sh 'mvn package -DskipTests'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                    archiveArtifacts artifacts: 'Ejercicio5Cliente/target/*.jar', fingerprint: true, allowEmptyArchive: true
                }
            }
        }
    }

    post {
        failure {
            echo 'El pipeline fallo - revisar logs de la etapa marcada.'
            echo '[ERROR] Pipeline Frontend falló. Revisar logs y reportes.'
        }
        cleanup {
            cleanWs()
        success {
            echo '[SUCCESS] Pipeline Frontend completado con éxito.'
        }
    }
}
